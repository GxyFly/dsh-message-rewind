{
  "name": "dsh-message-rewind",
  "version": "0.1.5",
  "description": "DeepSeek Harness 消息撤回：编辑历史消息，在原对话中回退模型上下文并继续，无需新建会话。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GxyFly/dsh-message-rewind.git"
  },
  "homepage": "https://github.com/GxyFly/dsh-message-rewind#readme",
  "bugs": {
    "url": "https://github.com/GxyFly/dsh-message-rewind/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "rewind",
    "message-editing"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "src",
    "tests",
    "build.mjs",
    "README.md",
    "RELEASE_NOTES.md",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "engines": {
    "dsh": "0.2.2-rc.5",
    "node": ">=24.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-commands"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "meta": {
    "title": "消息撤回",
    "description": "DeepSeek Harness 消息撤回：编辑历史消息，在原对话中回退模型上下文并继续，无需新建会话。"
  }
}
